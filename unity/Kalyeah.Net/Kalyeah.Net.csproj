<Project Sdk="Microsoft.NET.Sdk">
  <!-- The network layer (port of scripts/net/): Godot's wire format, rooms, the authoritative match, server and client, hotspot finding.
       Engine-free: the same files compile in Unity (Kalyeah.Net.asmdef), the dedicated server (Kalyeah.Server) and the tests. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Kalyeah.Net</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kalyeah.Sim/Kalyeah.Sim.csproj" />
  </ItemGroup>
</Project>
