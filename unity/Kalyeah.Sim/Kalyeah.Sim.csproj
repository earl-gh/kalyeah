<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game's rules (the sim), engine-free: the same files compile in Unity (Kalyeah.Sim.asmdef), the dedicated server and the tests. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Kalyeah.Sim</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
