[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, fog_disabled;

uniform vec4 edge_color : source_color = vec4(0.320000, 0.880000, 0.920000, 1.000000);
uniform vec4 tint : source_color = vec4(0.980000, 0.740000, 0.240000, 1.000000);
uniform float scroll_speed : hint_range(0.0, 12.0) = 3.4;
uniform float phase : hint_range(0.0, 1.0) = 0.0;
uniform float soft_fade : hint_range(0.0, 1.0) = 0.62;

void fragment() {
	float n_out17p0 = abs(UV.y - 0.5) * 2.0;
	float n_out23p0 = smoothstep(1.0, 0.08, n_out17p0);
	float n_out24p0 = smoothstep(0.28, 0.0, n_out17p0);
	vec2 n_out13p0 = UV + vec2(-(TIME * scroll_speed), 0.0);
	float n_out22p0 = sin(n_out13p0.x * 14.0) * 0.12 + 0.88;
	float n_out26p0 = smoothstep(phase, phase + 0.62, UV.x);
	vec3 n_out28p0 = mix(edge_color.rgb, tint.rgb, n_out23p0);
	vec3 n_out29p0 = mix(n_out28p0, vec3(1.0, 0.96, 0.80), n_out24p0 * 0.65);
	ALBEDO = n_out29p0 * COLOR.rgb;
	ALPHA = clamp(n_out23p0 * n_out22p0 * n_out26p0 * soft_fade * COLOR.a, 0.0, 1.0);
}
"
