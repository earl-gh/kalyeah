[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, fog_disabled;

uniform vec4 ring_color : source_color = vec4(1.000000, 0.780000, 0.220000, 1.000000);
uniform vec4 core_color : source_color = vec4(1.000000, 0.970000, 0.860000, 1.000000);
uniform float phase : hint_range(0.0, 1.0) = 0.0;
uniform float ring_sharpness : hint_range(0.03, 0.45) = 0.09;
uniform float soft_fade : hint_range(0.0, 1.0) = 1.0;

void fragment() {
	vec2 n_out10p0 = (UV + vec2(-0.5, -0.5) * vec2(1.0, 1.0));
	float n_out12p0 = length(n_out10p0) * 2.0;
	float n_out21p0 = sin(n_out10p0.x * 16.0 + TIME * 4.5) * 0.035 * cos(n_out10p0.y * 16.0);
	float n_out22p0 = n_out12p0 + n_out21p0;
	float n_out23p0 = mix(0.46, 0.90, phase);
	float n_out26p0 = smoothstep(n_out23p0 - ring_sharpness, n_out23p0, n_out22p0);
	float n_out28p0 = 1.0 - smoothstep(n_out23p0, n_out23p0 + ring_sharpness, n_out22p0);
	float n_out29p0 = n_out26p0 * n_out28p0;
	float n_out30p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 2.2);
	float n_out31p0 = smoothstep(0.83, 0.91, n_out22p0);
	float n_out32p0 = smoothstep(1.0, 0.90, n_out12p0);
	float n_out34p0 = max(n_out29p0, n_out31p0 * 0.82);
	float n_out37p0 = n_out34p0 * (n_out30p0 * 0.28 + 0.78);
	float n_out39p0 = max(n_out37p0, 0.04) * n_out32p0;
	vec3 n_out41p0 = mix(ring_color.rgb, core_color.rgb, n_out34p0) * COLOR.rgb;
	ALBEDO = n_out41p0;
	ALPHA = clamp(n_out39p0 * COLOR.a * soft_fade, 0.0, 1.0);
}
"
