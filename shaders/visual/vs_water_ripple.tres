[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, fog_disabled;

uniform vec4 aqua_color : source_color = vec4(0.240000, 0.820000, 0.780000, 1.000000);
uniform vec4 foam_color : source_color = vec4(0.940000, 0.990000, 0.970000, 1.000000);
uniform float ring_count : hint_range(1.0, 6.0) = 3.0;
uniform float phase : hint_range(0.0, 1.0) = 0.0;
uniform float soft_fade : hint_range(0.0, 1.0) = 1.0;

void fragment() {
	vec2 n_out10p0 = UV + vec2(-0.5, -0.5);
	float n_out12p0 = length(n_out10p0) * 2.0;
	float n_out18p0 = smoothstep(0.42, 0.94, sin((n_out12p0 - phase * 0.82) * ring_count * 6.283185));
	float n_out19p0 = smoothstep(0.98, 0.72, n_out12p0);
	float n_out28p0 = sin(n_out10p0.x * 18.0 + TIME) * 0.25 * cos(n_out10p0.y * 18.0) + 0.65;
	float n_out29p0 = smoothstep(phase, phase + 0.36, n_out28p0);
	float n_out31p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.5);
	vec3 n_out33p0 = mix(aqua_color.rgb, foam_color.rgb, max(n_out18p0, n_out31p0));
	ALBEDO = n_out33p0 * COLOR.rgb;
	ALPHA = clamp(max(n_out18p0, 0.05) * n_out19p0 * n_out29p0 * soft_fade * COLOR.a, 0.0, 1.0);
}
"
