[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, fog_disabled;

uniform vec4 aura_color : source_color = vec4(1.000000, 0.800000, 0.240000, 1.000000);
uniform vec4 accent_color : source_color = vec4(0.240000, 0.920000, 0.840000, 1.000000);
uniform float scroll_speed : hint_range(0.0, 4.0) = 0.85;
uniform float pulse_phase : hint_range(0.0, 6.2832) = 0.0;
uniform float soft_fade : hint_range(0.0, 1.0) = 0.92;

void fragment() {
	float n_out16p0 = smoothstep(1.0, 0.08, UV.y);
	vec2 n_out14p0 = UV + vec2(0.12, -(TIME * scroll_speed + pulse_phase));
	float n_out22p0 = smoothstep(-0.55, 0.65, sin(n_out14p0.x * 18.84955 + n_out14p0.y * 9.42477));
	float n_out23p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 1.75);
	ALBEDO = mix(aura_color.rgb, accent_color.rgb, UV.y) * COLOR.rgb;
	ALPHA = clamp(n_out16p0 * n_out22p0 * (n_out23p0 * 0.62 + 0.52) * soft_fade * COLOR.a, 0.0, 1.0);
}
"
