[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, fog_disabled;

uniform vec4 dust_tint : source_color = vec4(0.980000, 0.950000, 0.890000, 1.000000);
uniform vec4 shadow_tint : source_color = vec4(0.800000, 0.740000, 0.670000, 1.000000);
uniform float softness : hint_range(0.05, 0.95) = 0.42;
uniform float erosion_strength : hint_range(0.0, 1.0) = 0.45;

void vertex() {
	mat4 __wm = mat4(normalize(INV_VIEW_MATRIX[0]), normalize(INV_VIEW_MATRIX[1]), normalize(INV_VIEW_MATRIX[2]), MODEL_MATRIX[3]);
	__wm = __wm * mat4(vec4(cos(INSTANCE_CUSTOM.x), -sin(INSTANCE_CUSTOM.x), 0.0, 0.0), vec4(sin(INSTANCE_CUSTOM.x), cos(INSTANCE_CUSTOM.x), 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0));
	__wm = __wm * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_MATRIX = VIEW_MATRIX * __wm;
}

void fragment() {
	vec2 n_out8p0 = UV + vec2(-0.5, -0.5);
	float n_out10p0 = length(n_out8p0) * 2.0;
	float n_out18p0 = (sin(n_out8p0.x * 9.5) + cos(n_out8p0.y * 9.5)) * 0.14 * erosion_strength;
	float n_out22p0 = 1.0 - smoothstep(1.0 - softness, 1.0, n_out10p0 + n_out18p0);
	float n_out25p0 = (1.0 - COLOR.a) * 0.55;
	float n_out26p0 = smoothstep(n_out25p0, n_out25p0 + 0.42, n_out22p0);
	ALBEDO = mix(dust_tint.rgb, shadow_tint.rgb, n_out10p0) * COLOR.rgb;
	ALPHA = clamp(n_out26p0 * COLOR.a, 0.0, 1.0);
}
"
