[gd_resource type="Resource" script_class="NetRules" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/net/net_rules.gd" id="1_net"]

[resource]
script = ExtResource("1_net")
passcode_length = 8
passcode_alphabet = "ABCDEFGHJKMNPQRSTUVWXYZ23456789"
reconnect_window = 60.0
afk_after = 30.0
snapshot_rate = 20
interpolation_delay = 0.1
load_timeout = 15.0
pick_grace = 1.0
max_queued_inputs = 6
max_name_length = 12
default_port = 8080
connect_timeout = 75.0
wake_hint_after = 4.0
room_list_max = 30
room_list_min_gap = 1.0
room_list_refresh = 2.0
discovery_port = 8081
discovery_seconds = 5.0
discovery_interval = 1.0
discovery_burst = 8
ignored_interface_prefixes = PackedStringArray("lo", "rmnet", "ccmni", "pdp", "wwan", "seth", "v4-", "ppp", "tun", "tap", "wg", "ipsec", "dummy", "p2p")
client_interface_names = PackedStringArray("wlan0", "eth0")
fallback_hosts = PackedStringArray("192.168.43.1", "172.20.10.1")
