<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the game's manifest. Every permission here is for Local play (docs/GDD.md "Local rooms"). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the game hotspot (LocalOnlyHotspot) and joining it (WifiNetworkSpecifier): normal permissions, no prompt -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android 13 and up: "Nearby devices", never used for location -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <!-- Android 8 to 12 ask for location instead (Android 12 grants fine only with coarse in the same request) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <!-- tap to join: the host's phone answers as a card, the friend's reads it -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.KalyeahLocal"
            android:value="com.kalyeah.local.KalyeahLocal" />
        <service
            android:name="com.kalyeah.local.ShareService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/kalyeah_apdu" />
        </service>
    </application>
</manifest>
